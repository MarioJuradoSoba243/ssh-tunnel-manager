<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ssh.tunnelmanager.ui.shell.ShellController"
            styleClass="app-shell">
    <left>
        <VBox minWidth="190.0" prefWidth="230.0" maxWidth="280.0" spacing="12.0" styleClass="navigation-pane">
            <padding>
                <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
            </padding>
            <Label styleClass="application-title" text="%app.title" />
            <ListView fx:id="navigationList" accessibleText="%navigation.accessible" VBox.vgrow="ALWAYS" />
        </VBox>
    </left>
    <center>
        <StackPane styleClass="content-pane">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                <content>
                    <VBox fx:id="contentContainer" spacing="10.0" styleClass="content-container">
                        <Label fx:id="sectionTitle" styleClass="section-title" text="%navigation.home" />
                        <Label fx:id="sectionDescription" wrapText="true"
                               text="%home.description" />
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
